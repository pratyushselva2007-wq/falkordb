# FalkorDB Instance Configuration (Local Docker or FalkorDB Cloud)
# For Local Docker:
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_USERNAME=
FALKOR_PASSWORD=

# For FalkorDB Cloud (Uncomment and fill in):
# FALKOR_HOST=your-cluster-id.falkordb.cloud
# FALKOR_PORT=12345
# FALKOR_USERNAME=default
# FALKOR_PASSWORD=your_cloud_password

# Multi-Tenant & Team Prefix Settings
# Use your name or environment (e.g. dev, dev_alice, dev_bob, prod)
GRAPH_PREFIX=dev
REPO_NAME=acme_checkout

# LLM Provider Keys (Optional, for Scout and Fixer Agent LLM integration)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
